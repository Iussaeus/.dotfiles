#!/usr/bin/env bash

declare -A sessions

PATHS=$(find "$HOME/code" -mindepth 1 -maxdepth 1 -type d)
TMUX_SESSIONS=$(tmux list-sessions -F "#S")
for path in ${PATHS[@]}; do
	sessions[$(basename "${path/./_}")]="$path"
done

for session in ${TMUX_SESSIONS[@]}; do
	if [[ "$session" == "$(tmux list-sessions | awk -F: '/attached/{print $1}')" ]] && [[ -n $TMUX ]]; then
		unset 'sessions["$session"]'
	elif [[ $# -eq 0 ]] && [ -n "${sessions["$session"]}" ]; then
		unset 'sessions["$session"]'
		sessions["[TMUX] $session"]=""
	else
		sessions["$session"]=""
	fi
done

if [[ $# -eq 0 ]]; then
	selected_session=$(
		printf "%s\n" "${!sessions[@]}"                                                                                  |
		awk ' /^\[TMUX\] /{t[++n]=$0; next} {o[++m]=$0} END{for(i=1;i<=n;i++) print t[i]; for(i=1;i<=m;i++) print o[i]}' |
		fzf                                                                                                              |
		sed 's/\[TMUX\] //'
		)
	printf "%s\n" "${!sessions[@]}" | sort -r > $HOME/log
else
	selected_session=$1
fi

if [ -z "$selected_session" ]; then
	exit 0
fi

selected_path=${sessions["$selected_session"]}

if [[ -z "$(pgrep tmux)" ]]; then
	tmux & disown
fi

if [ -n "$selected_path" ]; then
	tmux new-session -ds $selected_session -c "$selected_path"
	tmux new-window -c $selected_path -t "$selected_session:1"
	tmux send-keys -t "$selected_session:1" "nvim ." C-m
	tmux select-window -t 0
fi

if [[ -z $TMUX ]]; then
	sub_cmd="attach"
else
	sub_cmd="switch-client"
fi

tmux "$sub_cmd" -t "$selected_session"
