#!/usr/bin/env bash

set -e
set -o pipefail

declare -A sessions

print-help() {
	cat <<END
Usage: ${name} [OPTIONS]... <session>
Manage tmux sessions in TMUX_SESSIONIZER_PROJECTS_DIR enviroment variable.

Options:
--debug                 print debug information after the execution
-h, --help              print this help message
-n, --session <session> open a new or existing session
--show-session-info     options: session-file, history, server-sock
-s, --save-session      save the current or selected session
-k, --kill-and-switch   kills current or selected session and switch to other one
--no-attach             don't attach to the new sesssion
END
}

is-managed() {
	if [ -z "$1" ]; then
		return 1
	fi

	if [[ -z ${sessions[$1]} && -z ${sessions["[TMUX] $1"]} ]]; then
		return 1
	fi

	return 0
}

debug-dump() {
	local _session=$session
	[ -e "$HOME/.cache/$name/$_session" ] && local _session_file="$HOME/.cache/$name/$_session.vim" 
	[ -e "$HOME/.cache/$name/${_session}_history" ] && local _hist_file="$HOME/.cache/$name/${_session}_history" 
	[ -e "/tmp/$name-$_session"local ] && _server_sock="/tmp/$name-$_session"
	if [[ -n $TMUX_SESSIONIZER && -z $session ]]; then 
		_session="$TMUX_SESSIONIZER_SESSION_NAME"
		_session_file="$TMUX_SESSIONIZER_NVIM_SESSION_FILE"
		_hist_file="$HISTFILE" 
		_server_sock="$TMUX_SESSIONIZER_NVIM_SERVER_SOCK"
	fi

	if is-managed "$_session"; then
		local managed=true
	else
		local managed=false
	fi

	echo "search dir: $search_dir"
	echo "name:$name, managed:$managed, session:$session, kill:$kill, search:$search, save:$save, attach:$attach"
	if [[ -n $TMUX_SESSIONIZER && "$managed" == true ]]; then
		echo "s:$_session sf:$_session_file, srv:$_server_sock"
	fi

	echo "env:"
	declare -p > "/tmp/tmux_sessionizer_env_after"
	declare -- search="1"
	comm -13 <(sort "/tmp/tmux_sessionizer_env_before") <(sort "/tmp/tmux_sessionizer_env_after")
	rm -f "/tmp/tmux_sessionizer_env_before" "/tmp/tmux_sessionizer_env_after"
}

kill-session() {
	local attached_session
	if [[ -n $TMUX_SESSIONIZER && -z $session ]]; then 
		attached_session="$TMUX_SESSIONIZER_SESSION_NAME"
	else
		attached_session="$(tmux display-message -p '#S')"
	fi

	local last_session="$(tmux list-sessions -F '#S' | grep -v "$attached_session\|default" | head -n1)"
	if [ "$attach" -eq 1 ] && [ -n "$last_session" ]; then
		tmux switch-client -t "$last_session"
	fi

	tmux kill-session -t "$attached_session"
}

save-session() {
	local _session="${session:-$(tmux display-message -p '#S')}"
	local _session_file="$HOME/.cache/$name/$_session.vim" 
	local _server_sock="/tmp/$name-$_session"
	if [[ -n $TMUX_SESSIONIZER && -z $session ]]; then 
		_session="$TMUX_SESSIONIZER_SESSION_NAME"
		_session_file="$TMUX_SESSIONIZER_NVIM_SESSION_FILE"
		_server_sock="$TMUX_SESSIONIZER_NVIM_SERVER_SOCK"
	fi

	if ! is-managed "$_session"; then
		echo "$name: cannot save non-managed session"
		return
	fi

	if [[ -z $_session || ! -e $_server_sock ]]; then
		return
	fi

	if [ ! -d "$_session_file" ]; then
		mkdir -p "$(dirname "$_session_file")"
	fi

	nvim --server "$_server_sock" --remote-send "<esc>:mksession! $_session_file<cr>"
}

find-sessions() {
	for path in $(find "$search_dir" -mindepth 1 -maxdepth 1 -type d); do
		sessions[$(basename "${path/./_}")]="$path"
	done

	if [ -z "$(pgrep tmux)" ]; then
		return
	fi

	local attached_session="${TMUX_SESSIONIZER_SESSION_NAME:-$(tmux display-message -p '#S')}"
	for s in $(tmux list-sessions -F "#S"); do
		if [[ $s  == "default" ]]; then
			unset 'sessions["$s"]'
		elif [[ -n "${sessions[$s]}" ]]; then
			sessions["[TMUX] $s"]="${sessions[$s]}"
			unset 'sessions["$s"]'
		fi
	done
}

make-new-session() {
	local session_file="$HOME/.cache/$name/$session.vim"
	local hist_file="$HOME/.cache/$name/${session}_history"
	local server_sock="/tmp/$name-$session"
	local session_path="${sessions["$session"]:-$(realpath "$search_dir/$session")}"

	if [ -z "$(pgrep tmux)" ]; then
		tmux -ds default
	fi

	if tmux has-session -t "$session" 2>/dev/null; then
		return
	fi

	tmux new-session -ds $session -c "$session_path"
	tmux set-environment -t "$session" "HISTFILE" "$hist_file" 
	tmux set-environment -t "$session" "TMUX_SESSIONIZER" "1" 
	tmux set-environment -t "$session" "TMUX_SESSIONIZER_PROJECTS_DIR" "$search_dir" 
	tmux set-environment -t "$session" "TMUX_SESSIONIZER_SESSION_NAME" "$session" 
	tmux set-environment -t "$session" "TMUX_SESSIONIZER_NVIM_SESSION_FILE" "$session_file" 
	tmux set-environment -t "$session" "TMUX_SESSIONIZER_NVIM_SERVER_SOCK" "$server_sock" 
	tmux set-hook -t "$session" after-new-window 'send-keys " HISTFILE=\"\$HISTFILE:\$(tmux display-message -p \#I_\#P)\";fc -p \$HISTFILE;clear;source \$HOME/.zshrc" C-m'

	tmux new-window -t "$session:1" -c "$session_path"
	tmux kill-window -t "$session:0"

	# don't know if this is right but if we sleep the histfile gets the correct window index
	sleep "0.5"
	tmux new-window -t "$session:1" -c "$session_path"
	if [ ! -e $server_sock ]; then
		if [ -e "$session_file" ]; then
			tmux send-keys -t "$session:1" "nvim --listen '$server_sock' -S '$session_file'" C-m
		else 
			tmux send-keys -t "$session:1" "nvim --listen '$server_sock' ." C-m
		fi
	fi
}

make-session-files() {
	local session_path="${sessions["$session"]:-$(realpath "$search_dir/$session")}"
	if [ ! -d "$session_path" ]; then
		mkdir -p "$session_path"
	fi

	local hist_file="$HOME/.cache/$name/${session}_history"
	for f in "$hist_file"*; do
		[ -e "$f" ] || continue
		rm -- "$f"
	done

	local session_file="$HOME/.cache/$name/$session.vim"
	if [ -e "$session_file" ]; then
		rm "$session_file"
	fi
}

show-session-info() {
	local _session="$session"
	local _session_file="$HOME/.cache/$name/$_session.vim" 
	local _hist_file="$HOME/.cache/$name/${_session}_history" 
	local _server_sock="/tmp/$name-$_session"
	if [[ -n $TMUX_SESSIONIZER && -z $session ]]; then 
		_session="$TMUX_SESSIONIZER_SESSION_NAME"
		_session_file="$TMUX_SESSIONIZER_NVIM_SESSION_FILE"
		_server_sock="$TMUX_SESSIONIZER_NVIM_SERVER_SOCK"
	fi

	if [ -z "$_session" ]; then
		echo "$name: no session provided"
		return
	fi


	if ! is-managed "$_session"; then
		echo "$name: cannot show info of non-managed session"
		return
	fi

	if [ -z "$_session" ]; then
		return
	fi

	case "$show_cmd" in
		session-file)
			if [ -e "${_session_file}" ]; then
				echo $_session_file
			fi
			;;
		history)
			find "$(dirname "$_hist_file")" -iwholename "$_hist_file*" | sort
			;;
		server-sock)
			if [ -e "${_server_sock}" ]; then
				echo $_server_sock
			fi
			;;
		*)
			echo "$name: invalid option '$show_cmd'"
			return 1
	esac
}

# NOTE: for debbuging
pos=1
for arg in "$@"; do
	if [ "$arg" == "--debug" ]; then
		declare -p > "/tmp/tmux_sessionizer_env_before"
		unset pos
		unset arg
		trap debug-dump EXIT
		break
	fi
	pos=$((pos+1))
done

name=$(basename "$0")
search_dir="$HOME/code"

search=1
attach=1
help=0
save=0
kill=0
show=0
show_cmd=""
arg=0
new=0
while [[ $# -ge 1 ]]; do 
	case $1 in
		-h|--help)
			help=1
			break
			;;
		-n|--session)
			shift
			search=0
			new=1
			session=$1
			;;
		-k|--kill-and-switch)
			kill=1
			;;
		--no-attach)
			attach=0
			;;
		-s|--save-session)
			save=1
			;;
		--debug)
			debug=1
			;;
		--show-session-info)
			shift
			show=1
			case "$1" in
				session-file|history|server-sock)
					show_cmd=$1
					;;

				'')
					echo "$name: options: session-file|history|server-sock"
					exit 1
					;;
				*)
					echo "$name: invalid option '$1'"
					exit 1
			esac
			;;
		*)
			if [ -z $session ]; then
				search=0
				session=$(tr '.' '_' <<< "$1")
			else
				echo "$name: unknown flag '$1'"
				exit 1
			fi
			;;
	esac
	shift
done

if grep -q "/" <<< "$session"; then
	echo "$name: invalid session name '$session'"
	exit 1
fi			

if [ "$help" -eq 1 ]; then
	print-help
	exit 0
fi

if [ ! -d "$search_dir" ]; then
	echo "$name: invalid path '$search_dir' in TMUX_SESSIONIZER_PROJECTS_DIR"
	exit 1
fi

find-sessions

if [ "$show" -eq 1 ]; then
	show-session-info
	exit $?
fi

if [ "$kill" -eq 1 ] && [ "$save" -eq 1 ]; then
	save-session
	kill-session
	exit 0
elif [ "$save" -eq 1 ]; then
	save-session
	exit 0
elif [ "$kill" -eq 1 ]; then
	kill-session
	exit 0
fi

if [[ -z "$(pgrep tmux)" ]]; then
	tmux new-session -d -s default
fi

if [ $search -eq 1 ]; then
	if [ -n "$TMUX_SESSIONIZER" ]; then
		session=$(
			printf "%s\n" "${!sessions[@]}"                                                                                                     |
			awk '!/^\[TMUX\]/{tmux[++n]=$0; next} !/\[TMUX\] '$TMUX_SESSIONIZER_SESSION_NAME'/ {print $0} END{for(i=1;i<=n;i++) print tmux[i]}' |
			fzf                                                                                                                                 |
			sed 's/\[TMUX\] //'
			)
	else
		session=$(
			printf "%s\n" "${!sessions[@]}"                                                        |
			awk '!/^\[TMUX\]/{tmux[++n]=$0; next} {print $0} END{for(i=1;i<=n;i++) print tmux[i]}' |
			fzf                                                                                    |
			sed 's/\[TMUX\] //'
			)
	fi
fi

if [ -z $session ]; then
	echo "$name: no session selected"
	exit 0
fi

if is-managed "$session"; then
	make-new-session
elif ! is-managed "$session" && [[ "$new" -eq 1 ]]; then
	make-session-files
	make-new-session
else
	echo "$name: cannot open session '$session'"
	exit 1
fi

if [ "$attach" -eq 1 ]; then
	if [ -z "$TMUX" ]; then
		tmux attach -t "$session"
	else
		tmux switch-client -t "$session"
	fi
fi
