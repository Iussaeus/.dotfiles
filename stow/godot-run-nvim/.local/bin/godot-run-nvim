#!/usr/bin/env bash

# WARN: Dont forget to set the Exec flags to: "{file}" "{line},{col}" "{project}"

if [ $# -ne 3 ]; then
	exit 1
fi

file=$1
pos=$2
session=$(basename $3 | tr '.' '_')
tmux_sessionizer="$HOME/.local/bin/tmux-sessionizer"
server='/tmp/godot-nvim-server'

echo "f:$file, p:$pos, s:$sesson, srv:$server" > $HOME/log

if [ -z "$server" ]; then
	nvim --listen "$server"
	sleep "0.2"

	nvim --server "$server" --remote-send "<esc>:e $file<CR>" >> $HOME/log
	nvim --server "$server" --remote-send "<esc>:call cursor($pos)<CR>" >> $HOME/log
else
	nvim --server "$server" --remote-send "<esc>:e $file<CR>"
	nvim --server "$server" --remote-send "<esc>:call cursor($pos)<CR>" >> $HOME/log
fi
