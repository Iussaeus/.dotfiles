// =============================================================================
//
// Waybar configuration
//
// Configuration reference: https://github.com/Alexays/Waybar/wiki/Configuration
//
// =============================================================================

{
        // -------------------------------------------------------------------------
        // Global configuration
        "layer": "top",
        "position": "bottom",
        "height": 20,
        "modules-left": [
            "sway/mode",
            "sway/workspaces"
        ],
        "modules-center": [
            // "privacy",
            "mpris"
        ],
        "modules-right": [
            "idle_inhibitor",
            "disk",
            "cpu",
            "memory",
            "pulseaudio",
            "power-profiles-daemon",
            "battery",
            "clock",
            "tray"
        ],

        // -------------------------------------------------------------------------
        // Modules
        // -------------------------------------------------------------------------

        "battery": {
            "interval": 10,
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "󰚥 {icon} ",
            "format-discharging": " {icon} ",
            "format-icons": [
                "",
                "",
                "",
                "",
                "" 
            ],
            "tooltip": true,
            "tooltip-format": "{capacity}% ({timeTo})"
        },
        "clock": {
            "tooltip": false,
            "interval": 10,
            "format": "{:%H:%M %A %b %e %Y}"
        },
        "cpu": {
            "interval": 5,
            "format": "   {usage}%", // Icon: microchip
            "states": {
                "warning": 70,
                "critical": 90
            }
        },

        "memory": {
            "interval": 5,
            "tooltip-format": "Used {used}GiB out of {total}GiB",
            "format": "  {used}GiB", // Icon: memory
            "states": {
                "warning": 70,
                "critical": 90
            }
        },

        "sway/workspaces": {
            "all-outputs": true,
            "disable-scroll": true,
            "format": "{icon} ",
            "format-icons": {
                "1": "", 
                "2": "󰖟", 
                "3": "", 
                "4": "󰓇",
                "5": "",
                "6": "",
                "7": "",
                "10": "",
                "urgent": "",
                "default": ""
            }
        },

        "pulseaudio": {
            "scroll-step": 2,
            "max-volume": 100,
            "format": "{icon} {volume}%",
            "format-muted": " 0%",
            "format-icons": {
                "headphones": "",
                "handsfree": "",
                "headset": "",
                "default": [" ", "  "]
            },
            "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "on-click-right": "pwvucontrol",
            "tooltip-format": "{volume}%"
        },

        "tray": {
            "icon-size": 13,
            "show-passive-items": true
        },
        "mpris": {
            "max-length": 45,
            "format": "{player_icon}    {status_icon}  {position} | {length} {artist} - {title}",
            "format-paused": "{player_icon}  {status_icon}  {position} | {length} <i>{artist} - {title}</i>",
            "player-icons": {
                "default": "",
                "spotify": "󰓇",
                "mpv": "🎵"
            },
            "status-icons": {
                "playing": "▶",
                "paused": "⏸"
            },
            "interval": 1
            // "ignored-players": ["firefox"]
        },

        "power-profiles-daemon": {
            "format": " {icon} ",
            "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
            "tooltip": true,
            "format-icons": {
                "default": "",
                "performance": "",
                "balanced": "",
                "power-saver": ""
            }
        },
        "disk": {
            "interval": 30,
            "format": "   {free}",
            "path": "/"
        },
        "privacy": {
            "icon-spacing": -10,
            "icon-size": 14,
            "transition-duration": 250,
            "modules": [
                {
                    "type": "screenshare",
                    "tooltip": true,
                    "tooltip-icon-size": 14
                },
                {
                    "type": "audio-out",
                    "tooltip": true,
                    "tooltip-icon-size": 14
                },
                {
                    "type": "audio-in",
                    "tooltip": true,
                    "tooltip-icon-size": 14
                }
            ]
        },
        "idle_inhibitor": {
            "format": "{icon} ",
            "format-icons": {
                "activated": "󰅶",
                "deactivated": "󰾪"
            }
        }
}
