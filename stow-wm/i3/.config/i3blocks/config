[MUSIC]
command=[ "$(playerctl -p spotify status)" == "Playing" ] && playerctl -p spotify metadata --format "{{artist}} - {{title}} {{duration(position)}}"
interval=1

[DISK]
command=df -h / | awk '/\//{ printf(" /: %4s \n", $4, $2) }'
interval=2

[BATTERY]
command=~/.config/i3blocks/battery/battery_info.sh
interval=3

[CPU]
command=mpstat 1 1 | awk '/Average:/ {printf("%s\n", $(NF-9))}' | awk '{ printf(" CPU:%6s% \n"), $1}'
interval=repeat

[USEDMEM]
command=free -h | awk '/Mem:/ { printf(" U: %5s \n",$3) }'
interval=1

[FREEMEM]
command=free -h | awk '/Mem:/ { printf(" F: %5s \n",$7) }'
interval=1

[VOLUME]
command=pactl get-sink-volume @DEFAULT_SINK@ | head -1 | awk '{ printf(" V: %4s\n"), $5}'
interval=1
signal=10

[TIME_DATE]
command=date +"%H:%M  %A, %B %d, %Y "
interval=1
